LIST_QUERY = """query($owner: String!, $name: String!, $after: String) {
  repository(owner: $owner, name: $name) {
    pullRequests(states: OPEN, first: 50, after: $after, orderBy: {field: CREATED_AT, direction: ASC}) {
      pageInfo { hasNextPage endCursor }
      nodes { number isDraft author { login } headRefName headRefOid changedFiles
              files(first: 5) { nodes { path changeType } } } } } }"""


class GitHubSource:
    """Real PRs through gh. Reads (always): GraphQL list + batched file contents. Writes (only with --live):
    comment, close, merge, git commit/push in the clone. Without --live every write is printed, not run."""
    def __init__(self, repo, live, workdir):
        self.repo, self.live, self.workdir = repo, live, workdir
        self.owner, self.name = repo.split("/", 1)

    def _graphql(self, query, **vars):
        args = ["api", "graphql", "-f", f"query={query}"]
        for k, v in vars.items():
            args += ["-F", f"{k}={v}"]
        out = subprocess.run(["gh", *args], capture_output=True, text=True)
        if out.returncode != 0:
            raise RuntimeError(f"gh api graphql: {out.stderr.strip()[:500]}")
        d = json.loads(out.stdout)
        if d.get("errors"):
            raise RuntimeError(f"graphql: {d['errors']}")
        return d["data"]

    def prs(self):
        out, after = [], None
        while True:
            v = {"owner": self.owner, "name": self.name}
            if after: v["after"] = after
            page = self._graphql(LIST_QUERY, **v)["repository"]["pullRequests"]
            for n in page["nodes"]:
                files = [{"path": f["path"], "changeType": f["changeType"]} for f in n["files"]["nodes"]]
                files += [{"path": "...", "changeType": "MODIFIED"}] * max(0, n["changedFiles"] - len(files))
                out.append({"number": n["number"], "author": (n["author"] or {}).get("login", ""), "draft": n["isDraft"],
                            "branch": n["headRefName"], "head": n["headRefOid"], "files": files})
            if not page["pageInfo"]["hasNextPage"]:
                return out
            after = page["pageInfo"]["endCursor"]

    def contents(self, wanted):
        """wanted: [(pr, path)] -> {number: bytes}; 25 PRs per GraphQL request, read from each PR's head commit."""
        got = {}
        for i in range(0, len(wanted), 25):
            parts = []
            for pr, path in wanted[i:i + 25]:
                expr = json.dumps(f"{pr['head']}:{path}")
                parts.append(f'p{int(pr["number"])}: pullRequest(number: {int(pr["number"])}) {{ headRepository {{ '
                             f'object(expression: {expr}) {{ ... on Blob {{ text byteSize isBinary }} }} }} }}')
            q = f'query {{ repository(owner: {json.dumps(self.owner)}, name: {json.dumps(self.name)}) {{ {" ".join(parts)} }} }}'
            repo = self._graphql(q)["repository"]
            for pr, _ in wanted[i:i + 25]:
                obj = ((repo.get(f"p{pr['number']}") or {}).get("headRepository") or {}).get("object")
                if obj and not obj.get("isBinary") and obj.get("text") is not None:
                    got[pr["number"]] = obj["text"].encode()
        return got

    def _gh(self, args):
        print("    $ gh " + " ".join(a if len(a) < 60 else a[:57] + "..." for a in args))
        if self.live:
            subprocess.run(["gh", *args, "--repo", self.repo], check=True, capture_output=True, text=True)

    def _git(self, *args):
        print("    $ git " + " ".join(args))
        if self.live:
            subprocess.run(["git", "-C", str(self.workdir), *args], check=True, capture_output=True, text=True)

    def sync(self):
        self._git("pull", "--ff-only", "-q")

    def comment(self, pr, body):
        self._gh(["pr", "comment", str(pr["number"]), "--body", body])

    def close(self, pr, body):
        self._gh(["pr", "close", str(pr["number"]), "--comment", body])

    def merge(self, pr, sha):
        self._gh(["pr", "merge", str(pr["number"]), "--squash", "--match-head-commit", sha])
        self.sync()

    def commit_files(self, paths, msg):
        self._git("add", *paths)
        self._git("commit", "-q", "-m", msg)
        self._git("pull", "--rebase", "-q")
        self._git("push", "-q")


class FixtureSource:
    """DIR/rounds.json: [{"now": "...Z", "prs": [{number, author, branch, head, files: [{path, changeType}],
    content_file}]}]. Writes go to SCRATCH/repo (plays main) and are printed; no gh, no git."""
    def __init__(self, fdir: Path, rnd: int, repo: Path):
        self.dir, self.repo = fdir, repo
        self.round = json.loads((fdir / "rounds.json").read_text())[rnd - 1]
        self.now = parse_ts(self.round["now"])
        self._by_number = {p["number"]: p for p in self.round["prs"]}

    def prs(self):
        return [dict(p) for p in self.round["prs"]]

    def contents(self, wanted):
        return {pr["number"]: (self.dir / self._by_number[pr["number"]]["content_file"]).read_bytes() for pr, _ in wanted}

    def sync(self): pass
    def comment(self, pr, body): print(f"    (fixture) gh pr comment {pr['number']}")
    def close(self, pr, body): print(f"    (fixture) gh pr close {pr['number']} --comment")

    def merge(self, pr, sha):
        print(f"    (fixture) gh pr merge {pr['number']} --squash --match-head-commit {sha}")
        f = self._by_number[pr["number"]]
        dest = self.repo / f["files"][0]["path"]
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes((self.dir / f["content_file"]).read_bytes())

    def commit_files(self, paths, msg):
        print(f"    (fixture) git add {' '.join(paths)} && git commit -m {msg!r} && git push")


def comment_body(rejects, flags, kept):
