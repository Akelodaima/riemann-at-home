FIRSTS_SEED = HERE / "firsts-seed.json"


def load_firsts_seed():
    """Times recovered from the published data.json history (2026-11-25), from before the bot kept the ledger."""
    return json.loads(FIRSTS_SEED.read_text()) if FIRSTS_SEED.exists() else {}


def merge_firsts(a, b):
    """Per login and key, the earlier time wins."""
    out = {k: dict(v) for k, v in a.items()}
    for login, v in b.items():
        for k, t in v.items():
            cur = out.setdefault(login, {}).get(k)
            out[login][k] = min(cur, t) if cur else t
    return out


class State:
    """STATE/state.json + STATE/accepted/<login>/<build_id>.json (last accepted version of each open PR's build)."""
    def __init__(self, d: Path, persist: bool):
        self.dir, self.persist = d, persist
        f = d / "state.json"
        self.data = json.loads(f.read_text()) if f.exists() else {"prs": {}, "last_publish": None, "published_hash": None}
        self.mem = {}                                   # dry run: accepted versions held in memory only
        sf = d / "signatures.json"                      # login -> time the signing version was accepted
        self.signed = json.loads(sf.read_text()) if sf.exists() else {}
        ff = d / "firsts.json"                          # login -> first whole proof / first Level 2 (see build_data)
        self.firsts = merge_firsts(json.loads(ff.read_text()) if ff.exists() else {}, load_firsts_seed())

    def pr(self, n):
        return self.data["prs"].setdefault(str(n), {})

    def accepted(self, rp):
        if rp in self.mem: return self.mem[rp]
        f = self.dir / "accepted" / rp.removeprefix("submissions/")
        return json.loads(f.read_text()) if f.exists() else None

    def set_accepted(self, rp, body: bytes):
        self.mem[rp] = json.loads(body)
        if self.persist:
            f = self.dir / "accepted" / rp.removeprefix("submissions/")
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_bytes(body)

    def drop(self, n, keep_record=False):
        """keep_record: the PR went away unmerged (closed, fork deleted). Its last accepted version stays on the
        board: it passed every check, and a finished, validated or signed build must not vanish (2026-11-25 review).
        A new PR for the same build continues from it."""
        st = self.data["prs"].pop(str(n), {})
        rp = st.get("path")
        if rp and self.persist and not keep_record:
            f = self.dir / "accepted" / rp.removeprefix("submissions/")
            if f.exists():
                f.unlink()                              # bot's own state copy; the record lives on in git / main

    def save(self):
        if self.persist:
            write_json_backed_up(self.dir / "signatures.json", self.signed, backup=False)
            write_json_backed_up(self.dir / "firsts.json", self.firsts, backup=False)
            write_json_backed_up(self.dir / "state.json", self.data, backup=False)


def identity_problem(pr, repo: Path, open_builds: dict):
    """Reasons to CLOSE (identity/path); None if fine. Returns (problem, path)."""
    files = pr["files"]
    if len(files) != 1:
        return f"the PR changes {len(files)} files; it must change only submissions/<login>/<build_id>.json", None
    path = files[0]["path"]
    m = PATH_RE.match(path)
    if not m:
        return f"{path} is not submissions/<github-login>/<build_id>.json", None
    if canon(m.group(1)).lower() != canon(pr["author"]).lower():
        return f"the file is under {m.group(1)!r} but the PR author is {pr['author']!r}", None
    if (repo / path).exists():                         # merged = whole or final; one PR per build for life
        return f"build {m.group(2)} is already merged (final); a new build needs a new build_id", None
    other = open_builds.setdefault(path.lower(), pr["number"])
    if other != pr["number"]:
        return f"build {m.group(2)} already has an open PR (#{other}); updates go to that PR", None
    return None, path


def cmd_poll(a):
    workdir = Path(a.workdir).resolve()
    if a.fixtures:
        if a.round == 1 and workdir.exists():
            shutil.rmtree(workdir)                      # scratch only (fixture mode)
        if a.lose_state and (workdir / "state").exists():   # recovery test: the bot's state is gone
            os.replace(workdir / "state", workdir / f"state.lost-round{a.round}")
        if a.lose_backups and (workdir / "state-backups").exists():
            os.replace(workdir / "state-backups", workdir / f"state-backups.lost-round{a.round}")
        repo, state_dir = workdir / "repo", workdir / "state"
        repo.mkdir(parents=True, exist_ok=True)
        src = FixtureSource(Path(a.fixtures).resolve(), a.round, repo)
        now, persist, mode = src.now, True, f"fixtures round {a.round}"
    else:
        if not a.repo:
            sys.exit("poll needs --repo OWNER/NAME or --fixtures DIR --round K")
        repo = workdir
        if not (repo / ".git").exists():
            sys.exit(f"--workdir {repo} must be a git clone of {a.repo}")
        state_dir = Path(a.state).resolve() if a.state else HERE / "state"
        src = GitHubSource(a.repo, a.live, repo)
        now, persist, mode = datetime.now(timezone.utc), a.live, "LIVE" if a.live else "dry run (nothing written)"
    print(f"rahbot poll ({mode}) now={now:%Y-%m-%dT%H:%M:%SZ}")
    rebuilding = False                                  # state AND backups lost: signed times fall back to recorded
    if persist and not (state_dir / "state.json").exists() and not (a.fixtures and a.round == 1):
        rebuilding = not restore_state(state_dir)
    st = State(state_dir, persist)
    src.sync()
    prs = sorted(src.prs(), key=lambda p: p["number"])
    open_numbers = {str(p["number"]) for p in prs}
    for n in [n for n in st.data["prs"] if n not in open_numbers]:
        print(f"#{n}: no longer open; its last accepted version stays on the board")
        st.drop(n, keep_record=True)

    open_builds, todo, paths = {}, [], {}
    for pr in prs:
        problem, path = identity_problem(pr, repo, open_builds)
        if problem:
            print(f"#{pr['number']} {pr['author']}: CLOSE ({problem})")
            src.close(pr, close_body(problem))
            st.drop(pr["number"])
            continue
        paths[pr["number"]] = path
        s = st.pr(pr["number"])
        s.setdefault("path", path)
        if s.get("seen_sha") != pr["head"]:
            todo.append((pr, path))
    bodies = src.contents(todo) if todo else {}
    # a head whose file GitHub did not return this time (fork briefly unavailable) is retried next poll, not marked
    # seen; only a PR that deletes the file gets the "file not found" reject (2026-11-25 review)
    bodies_missing_ok = {pr["number"] for pr, _ in todo
                         if pr["number"] not in bodies and pr["files"][0].get("changeType") != "DELETED"}
    logins = ({f.parent.name for d in (repo / "submissions", state_dir / "accepted") if d.exists() for f in d.glob("*/*.json")}
              | {p["author"] for p in prs})            # every participant, for the display_name rule

    for pr in prs:
        n, author = pr["number"], pr["author"]
        if n not in paths:
            continue
        path, s = paths[n], st.pr(n)
        prev = st.accepted(path)                       # None after state loss: head re-checked as a first version
        if s.get("seen_sha") != pr["head"] and bodies.get(n) is None and n in bodies_missing_ok:
            print(f"#{n} {author}: could not read version {pr['head'][:8]} yet; trying again next poll")
        elif s.get("seen_sha") != pr["head"]:          # a new version on the branch
            s["seen_sha"], s["seen_at"] = pr["head"], now.strftime("%Y-%m-%dT%H:%M:%SZ")
            body = bodies.get(n)
            try:
                if body is None: raise ValueError("file not found at the PR head")
                if len(body) > MAX_RECORD_BYTES: raise ValueError("record is too large")
                rec = json.loads(body)
            except Exception as e:
                rec, rejects, flags = None, [f"record unreadable: {e}"], []
            if rec is not None:
                rejects, flags, _ = check_record(rec, author, path, prev, check_digest=a.check_digest, now=now,
                                                 logins=logins)
            pending = not rejects and any(f.startswith("PENDING") for f in flags)
            if rejects:
                kept = f"your last accepted version ({prev['modules_compiled']:,} modules)" if prev else "nothing yet for this build"
                same = [re.sub(r"[0-9][0-9,.]*", "#", r) for r in s.get("last_comment") or []] == \
                       [re.sub(r"[0-9][0-9,.]*", "#", r) for r in rejects]
                if not same:   # comment once per distinct failure (numbers ignored), not every poll
                    print(f"#{n} {author}: REJECT version {pr['head'][:8]}, comment" + "".join(f"\n    - {r}" for r in rejects))
                    src.comment(pr, comment_body(rejects, flags, kept))
                    s["last_comment"] = rejects
                else:
                    print(f"#{n} {author}: REJECT version {pr['head'][:8]} (same reasons, already commented)")
            elif pending:
                print(f"#{n} {author}: PENDING version {pr['head'][:8]}" + "".join(f"\n    {f}" for f in flags))
            else:
                st.set_accepted(path, body)
                if rec.get("sign_statement") is True and signs_300k(rec):     # the one statement, either proof
                    st.signed.setdefault(author, rec["recorded"] if rebuilding           # acceptance time unknown after total loss
                                         else now.strftime("%Y-%m-%dT%H:%M:%SZ"))   # time the signing version was accepted
                if s.get("last_comment"):   # it was rejected before: say so on the PR, once
                    src.comment(pr, f"Your latest version ({rec['modules_compiled']:,} modules) was accepted and is on the "
                                    "leaderboard. The earlier rejections above no longer apply.\n\n(rahbot)")
                s["accepted_sha"], s["last_comment"] = pr["head"], None
                prev = rec
                print(f"#{n} {author}: ACCEPT version {pr['head'][:8]} ({rec['modules_compiled']:,} modules)"
                      + "".join(f"\n    FLAG {f}" for f in flags))
        else:
            print(f"#{n} {author}: unchanged since {s.get('seen_at')}")
        # merge?
        if prev is None:
            continue
        # Only `finish` (final) merges. A whole-proof PR stays open so its export progress and Level 2/3 result
        # (export_sha256, checkers, sign_statement) can still arrive on it (2026-11-22). No time-based merge.
        why = "final" if prev.get("final") else None
        if not why or pr.get("draft"):
            continue
        try:
            if s.get("accepted_sha") == pr["head"]:
                print(f"#{n} {author}: MERGE ({why})")
                src.merge(pr, pr["head"])              # --match-head-commit: fails if the branch moved meanwhile
            else:                                      # rare: branch moved to a failing version before the merge
                print(f"#{n} {author}: MERGE last accepted version ({why}; the PR head failed checks)")
                if persist:
                    write_json_backed_up(repo / path, prev, backup=False)
                src.commit_files([path], f"{path}: last accepted version ({why})")
                src.close(pr, f"Merged your last accepted version ({prev['modules_compiled']:,} modules) to main; "
                              f"the newer versions on this branch did not pass checks. (rahbot)")
        except Exception as e:                         # retried next poll; the accepted version stays on the board
            print(f"#{n} {author}: merge failed, will retry: {e}")
            continue
        st.drop(n)

    # data.json: merged builds on main + accepted versions of open PRs; republish at most every 10 minutes
    if not persist:
        print("dry run: data.json not rebuilt")
        return 0
    pub = repo / "docs" / "data.json"
    try:
        published = json.loads(pub.read_text()) if pub.exists() else None
    except ValueError:
        published = None
    data = build_data([repo / "submissions", state_dir / "accepted"], now=now, signed_map=st.signed, firsts=st.firsts,
                      published=published)
    published = False
    h = content_hash(data)
    last = st.data.get("last_publish")
    on_disk = repo / "docs" / "data.json"                  # what the site actually serves
    try: disk_h = content_hash(json.loads(on_disk.read_text()))
    except (OSError, ValueError): disk_h = None
    if h == st.data.get("published_hash") and h == disk_h:
        print("data.json: unchanged")
    elif last and now - parse_ts(last) < PUBLISH_EVERY:
        print(f"data.json: changed, publish deferred (last publish {last}, at most every {PUBLISH_EVERY.total_seconds() / 60:g} min)")
    else:
        site = repo / "docs"                                           # GitHub Pages serves main:/docs
        try:                                                           # what's new since the last publish (replayed)
            rec = recent_since(json.loads(on_disk.read_text()), data)
        except (OSError, ValueError):
            rec = None
        if rec:
            data["recent"] = rec
        write_json_backed_up(site / "data.json", data, backup=False)   # git keeps history
        shutil.copyfile(MODULES_TXT, site / "modules.txt")             # CONTRACT: published next to index.html
        files = ["docs/data.json", "docs/modules.txt"]
        for pk, P in PROOFS.items():                                   # and each other proof's list
            if pk != DEFAULT_PROOF:
                shutil.copyfile(P["modules_txt"], site / P["modules_txt"].name)
                files.append(f"docs/{P['modules_txt'].name}")
        try:                                                           # the homepage as markdown, for AI readers
            (site / "index.md").write_text(homepage_markdown(data, (site / "index.html").read_text()))
            files.append("docs/index.md")
        except Exception as e:
            print(f"index.md not written: {e}")
        src.commit_files(files, f"data.json: {data['summary']['people']} people")
        st.data["last_publish"], st.data["published_hash"] = now.strftime("%Y-%m-%dT%H:%M:%SZ"), h
        print(f"data.json: published {data['summary']}; running {len(data['running'])}; signatures {len(data['signatures'])}")
        published = True
    st.save()
    if published:
        backup_state(state_dir, now)
    return 0


def backup_state(state_dir: Path, now):
    """Timestamped copy of the whole bot state (accepted versions, state.json, signatures.json)
    in STATE/../state-backups/, newest 20 kept."""
    root = state_dir.parent / "state-backups"
    dest = root / now.strftime("%Y%m%dT%H%M%SZ")
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(state_dir, dest)
    old = sorted(p for p in root.iterdir() if p.is_dir())[:-BACKUPS_KEPT]
    for p in old:
        shutil.rmtree(p)                               # the bot's own old backups only
    print(f"state backed up to {dest.name} ({min(len(list(root.iterdir())), BACKUPS_KEPT)} kept)")


def restore_state(state_dir: Path):
    """State lost: restore the newest backup; with none, the poll falls back to re-checking heads as first versions."""
    root = state_dir.parent / "state-backups"
    backups = sorted(p for p in root.iterdir() if p.is_dir()) if root.exists() else []
    if not backups:
        print("state missing and no backup: rebuilding from open PR heads, each checked as a first version")
        return False
    shutil.copytree(backups[-1], state_dir)
    print(f"state missing: restored newest backup {backups[-1].name}")
    return True


# ---- commands -----------------------------------------------------------------------------------------------
def cmd_check(a):
    p = Path(a.record)
    try:
        rec = load_record(p)
    except Exception as e:
        print(f"REJECT\n  - record unreadable: {e}"); return 1
    prev = None
    if a.prev != "none":
        prev = load_record(Path(a.prev))
    rp = a.path or "/".join(p.resolve().parts[-3:])
    logins = set(filter(None, (a.logins or "").split(",")))
    rejects, flags, _ = check_record(rec, a.author, rp, prev, check_digest=a.check_digest, logins=logins)
    pending = not rejects and any(f.startswith("PENDING") for f in flags)
    print("REJECT" if rejects else "PENDING" if pending else "ACCEPT")
    for r in rejects: print(f"  - {r}")
    for f in flags: print(f"  FLAG {f}")
    return 1 if rejects else 2 if pending else 0


def cmd_reference_digest(a):
    text = Path(a.bitmap).read_text().strip()
    b64 = json.loads(text)["bitmap_b64"] if text.startswith("{") else text
    raw = decode_bitmap(b64)
    try:
        print(reference_digest(raw))
    except LookupError as e:
        print(f"error: {e}", file=sys.stderr); return 1
    return 0


def cmd_reference_snapshot(a):
    mods = modules()
    out = bytearray(32 * N)
    have = 0
    for i, m in enumerate(mods):
        h = olean_sha256(REFERENCE, m)
        if h:
            out[32 * i:32 * i + 32] = h; have += 1
    p = Path(a.out)
    if p.exists():
        shutil.copy2(p, p.with_name(p.name + ".bak"))
    p.write_bytes(bytes(out))
    print(f"{a.out}: {have:,} of {N:,} reference modules hashed")
    return 0


def cmd_aggregate(a):
    sig = Path(a.signed_map) if a.signed_map else None
    signed_map = json.loads(sig.read_text()) if sig and sig.exists() else {}
    ff = Path(a.firsts) if a.firsts else None
    firsts = json.loads(ff.read_text()) if ff and ff.exists() else {}
    data = build_data([Path(d) for d in a.dirs], signed_map=signed_map, firsts=firsts)
    if sig:
        write_json_backed_up(sig, signed_map)
    if ff:
        write_json_backed_up(ff, firsts)
    write_json_backed_up(Path(a.out), data)
    mt = Path(a.out).resolve().with_name("modules.txt")       # CONTRACT: modules.txt travels with data.json
    if mt != MODULES_TXT.resolve():
        shutil.copyfile(MODULES_TXT, mt)
    s = data["summary"]
    print(f"{a.out}: {s['people']} people, {s['whole_proofs']} whole proofs, "
          f"{s['modules_built_once']:,} modules built once, {s['modules_built_3x']:,} three times")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="rahbot", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("record"); c.add_argument("--author", required=True); c.add_argument("--prev", required=True)
    c.add_argument("--path", help="the record's path in the repo (default: last 3 parts of RECORD's path)")
    c.add_argument("--logins", help="comma-separated GitHub logins of the other participants (display_name rule)")
    c.add_argument("--check-digest", action="store_true", help="require olean_digest == reference (off until M0)")
    c.add_argument("--reference-hashes", help="frozen snapshot from reference-snapshot (default: live build folder)")
    r = sub.add_parser("reference-digest"); r.add_argument("bitmap"); r.add_argument("--reference-hashes")
    s = sub.add_parser("reference-snapshot"); s.add_argument("--out", required=True)
    g = sub.add_parser("aggregate"); g.add_argument("dirs", nargs="+"); g.add_argument("--out", required=True)
    g.add_argument("--signed-map", help="login -> signed time (the bot's ledger); default: signing record's recorded")
    g.add_argument("--firsts", help="login -> first whole proof / first Level 2 times (the bot's ledger, updated)")
    p = sub.add_parser("poll")
    p.add_argument("--repo"); p.add_argument("--workdir", required=True)
    p.add_argument("--live", action="store_true", help="really merge / comment / push (default: print only)")
    p.add_argument("--state", help="bot state dir (default: next to rahbot)")
    p.add_argument("--fixtures", help="read fake PRs from DIR/rounds.json; never calls gh or git")
    p.add_argument("--round", type=int, default=1, help="fixture round (1-based; 1 starts fresh)")
    p.add_argument("--lose-state", action="store_true", help="fixtures only: move the bot state away first (recovery test)")
    p.add_argument("--lose-backups", action="store_true", help="fixtures only: also move the state backups away")
    p.add_argument("--check-digest", action="store_true"); p.add_argument("--reference-hashes")
    a = ap.parse_args()
    use_snapshot(getattr(a, "reference_hashes", None))
    if a.cmd == "poll" and a.fixtures and a.live:
        sys.exit("--fixtures and --live are exclusive")
    fn = {"check": cmd_check, "reference-digest": cmd_reference_digest,
          "reference-snapshot": cmd_reference_snapshot, "aggregate": cmd_aggregate, "poll": cmd_poll}[a.cmd]
    sys.exit(fn(a) or 0)


if __name__ == "__main__":
    main()
