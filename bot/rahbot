# ---- helpers ------------------------------------------------------------------------------------------------
_modules = {}
def modules(proof: str = DEFAULT_PROOF) -> list:
    """The proof's published module list (sorted byte-wise), checked against its pinned sha256."""
    if proof not in _modules:
        p = PROOFS[proof]
        raw = p["modules_txt"].read_bytes()
        if hashlib.sha256(raw).hexdigest() != p["modules_sha256"]:
            sys.exit(f"{p['modules_txt']} is not the published module list (sha256 mismatch)")
        _modules[proof] = raw.decode().split("\n")[:-1]
        assert len(_modules[proof]) == p["n"]
    return _modules[proof]


def parse_ts(s: str) -> datetime:
    if not isinstance(s, str) or not TS_RE.match(s):
        raise ValueError(f"not a UTC time like 2026-11-21T15:26:31Z: {s!r}")
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def decode_bitmap(b64: str, n: int = N) -> bytes:
    """bitmap_b64 -> exactly ceil(n/8) bytes (n = the proof's module count). Raises ValueError. Bounded
    decompression (no gzip bombs)."""
    N = n
    try:
        gz = base64.b64decode(b64, validate=True)
    except Exception:
        raise ValueError("bitmap_b64 is not valid base64")
    want = (N + 7) // 8
    try:
        d = zlib.decompressobj(16 + zlib.MAX_WBITS)       # gzip container
        raw = d.decompress(gz, want + 1)
        if d.unconsumed_tail or len(raw) > want:
            raise ValueError(f"bitmap is longer than {want} bytes")
        raw += d.flush()
        if not d.eof:
            raise ValueError("bitmap gzip stream is truncated")
    except zlib.error as e:
        raise ValueError(f"bitmap_b64 is not gzip: {e}")
    if len(raw) != want:
        raise ValueError(f"bitmap is {len(raw)} bytes, expected {want} (N = {N} bits)")
    if N % 8 and raw[-1] >> (N % 8):
        raise ValueError("bitmap has bits set past module N-1")
    return raw


def encode_bitmap(raw: bytes) -> str:
    return base64.b64encode(gzip.compress(raw, mtime=0)).decode()


def bits_from_indices(idx, n: int = N) -> bytes:
    b = bytearray((n + 7) // 8)
    for i in idx:
        b[i >> 3] |= 1 << (i & 7)
    return bytes(b)


def indices(raw: bytes):
    for byte_i, v in enumerate(raw):
        while v:
            low = v & -v
            yield byte_i * 8 + low.bit_length() - 1
            v ^= low


def popcount(raw: bytes) -> int:
    return int.from_bytes(raw, "little").bit_count()


def is_superset(new: bytes, old: bytes) -> bool:
    return (int.from_bytes(old, "little") & ~int.from_bytes(new, "little")) == 0


def load_record(path: Path) -> dict:
    if path.stat().st_size > MAX_RECORD_BYTES:
        raise ValueError(f"record is larger than {MAX_RECORD_BYTES} bytes")
    d = json.loads(path.read_text())
    if not isinstance(d, dict):
        raise ValueError("record is not a JSON object")
    return d


def olean_sha256(ref: Path, module: str):
    """sha256 of one reference .olean (32 raw bytes), or None if not compiled there. Opened read-only.
    CONTRACT: compiled = .olean AND .trace exist (Lake writes the trace last; olean alone = interrupted build)."""
    h = hashlib.sha256()
    base = ref / ".lake/build/lib/lean" / module.replace(".", "/")
    if not os.path.exists(f"{base}.trace"):
        return None
    try:
        with open(f"{base}.olean", "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    except FileNotFoundError:
        return None
    return h.digest()


_snapshot = None
def use_snapshot(path):
    """Use a frozen per-module hash table (from `reference-snapshot`) instead of the live build folder.
    A build in progress deletes and rewrites .olean files, so the live folder is not a stable reference."""
    global _snapshot
    if path:
        _snapshot = Path(path).read_bytes()
        if len(_snapshot) != 32 * N:
            sys.exit(f"{path} is not a reference snapshot ({32 * N} bytes expected)")


def reference_digest(raw: bytes, ref: Path = REFERENCE) -> str:
    """CONTRACT olean_digest: sha256 over, for each set bit in index order, sha256(.olean bytes) as 32 raw bytes.
    Raises LookupError if the reference has not compiled every module in the bitmap (the rule can't decide yet)."""
    mods, outer, missing = modules(), hashlib.sha256(), []
    for i in indices(raw):
        if _snapshot is not None:
            h = _snapshot[32 * i:32 * i + 32]
            if h == bytes(32): missing.append(mods[i])
            else: outer.update(h)
            continue
        h = olean_sha256(ref, mods[i])
        if h is None: missing.append(mods[i])
        else: outer.update(h)
    if missing:
        raise LookupError(f"reference build has not compiled {len(missing)} of these modules (first: {missing[0]})")
    return outer.hexdigest()


# ---- the acceptance rules -----------------------------------------------------------------------------------
def clean_display_name(name: str) -> str:
    return name.strip()                                # CONTRACT: trim ends (the trimmed text is what is shown)


def name_key(text: str) -> str:
    return unicodedata.normalize("NFKC", text).casefold()


def display_name_problems(rec, author, logins, prev=None):
    """CONTRACT (CLI and bot identical): trim ends, 1-32 chars, no Unicode Cc/Cf/Zl/Zp; NFKC + casefold must not
    equal any other participant's login."""
    out, name = [], rec.get("display_name")
    if name is None:
        return out
    name = clean_display_name(name)
    if not 1 <= len(name) <= 32:
        out.append(f"display_name must be 1-32 characters after trimming (got {len(name)})")
    if any(unicodedata.category(ch) in ("Cc", "Cf", "Zl", "Zp") for ch in name):
        out.append("display_name contains control or invisible formatting characters")
    key = name_key(name)
    if key.startswith("anonymous"):
        out.append("display_name may not start with \"anonymous\" (nobody here is anonymous: the pull request shows the username)")
    if prev is not None and prev.get("display_name") is not None and name_key(clean_display_name(prev["display_name"])) == key:
        return out                                     # accepted before: a name is judged once, never re-judged
    if any(key == name_key(l) for l in (logins or ()) if name_key(l) != name_key(author)):
        out.append(f"display_name {name!r} is another participant's GitHub login")
    return out


def signs_300k(rec) -> bool:
    """A 300K record that qualifies for its statement: whole, its theorems using only the three standard axioms."""
    ax = rec.get("axioms")
    return bool(rec.get("whole_proof")) and isinstance(ax, list) and sorted(ax) == sorted(EXPECTED_AXIOMS)


def record_level(rec) -> int:
    """1 build; 2 whole proof + reference export reproduced; 3 = 2 + a known independent checker accepted it."""
    if not (rec.get("whole_proof") and str(rec.get("export_sha256", "")).lower() == REF_EXPORT_SHA256
            and rec.get("export_bytes", REF_EXPORT_BYTES) == REF_EXPORT_BYTES):
        return 1
    ok = [c for c in rec.get("checkers") or [] if isinstance(c, dict) and c.get("result") == "accept"
          and c.get("name") in KNOWN_CHECKERS]
    return 3 if ok else 2


def check_record(rec, author: str, repo_path: str, prev, check_digest=False, now=None, logins=None):
    """-> (rejects, flags, bitmap). rejects empty = ACCEPT, unless a flag starts with PENDING (can't decide yet). prev = this build's last accepted version (dict) or None."""
    now = now or datetime.now(timezone.utc)
    rej, flags = [], []
    # schema
    if not isinstance(rec, dict):
        return ["record is not a JSON object"], flags, None
    pk = proof_of(rec)
    if not isinstance(pk, str) or pk not in PROOFS:
        return [f"proof {pk!r} is not one of {sorted(PROOFS)}"], flags, None
    P = PROOFS[pk]
    fields = {**FIELDS, P["source_field"]: str}        # 17M: archive_sha256; 300K: source_commit
    optional = OPTIONAL if P["levels"] else {k: t for k, t in OPTIONAL.items() if k not in LEVEL_FIELDS
                                             or k in ("sign_statement", "export_sha256", "export_bytes")}
    missing = [k for k in fields if k not in rec]
    if "anonymous" in rec:                             # dropped: the pull request always shows the GitHub username
        rej.append("anonymous is not offered: your pull request always shows your GitHub username. "
                   "Use a display name (`riemann-at-home name \"...\"`) or none")
    levels_here = [k for k in rec if k in LEVEL_FIELDS and k not in optional]
    if levels_here:
        rej.append(f"{levels_here} are 17M only: the {P['label']} proof has no export reference yet, so a whole "
                   "build with the expected axioms is its finish")
    extra = [k for k in rec if k not in fields and k not in optional and k != "anonymous" and k not in levels_here]
    if missing: rej.append(f"schema: missing fields {missing}")
    if extra: rej.append(f"schema: unknown fields {extra}")
    for k, t in {**fields, **OPTIONAL}.items():
        if k in rec and (not isinstance(rec[k], t) or (t is int and isinstance(rec[k], bool))):
            rej.append(f"schema: {k} has the wrong type")
    m = rec.get("machine")
    if isinstance(m, dict):
        for k, t in MACHINE_FIELDS.items():
            if not isinstance(m.get(k), t) or isinstance(m.get(k), bool):
                rej.append(f"schema: machine.{k} missing or wrong type")
    if rej:
        return rej, flags, None
    rej += display_name_problems(rec, author, logins, prev)
    # format / tool known
    if rec["format"] != FORMAT: rej.append(f"format {rec['format']!r} is not {FORMAT!r}")
    if rec["tool"] not in KNOWN_TOOLS: rej.append(f"tool {rec['tool']!r} is not a known release")
    # constants (the proof's own)
    for k, want in ((P["source_field"], P["source"]), ("toolchain", P["toolchain"]), ("mathlib_rev", P["mathlib_rev"])):
        if rec[k] != want: rej.append(f"{k} {rec[k]!r} is not the pinned {want!r}" + ("" if pk == DEFAULT_PROOF else f" for {P['label']}"))
    if rec["build_folder"] not in P["build_folders"]:
        rej.append(f"build_folder {rec['build_folder']!r} is not a fixed {P['label']} build folder")
    # identity: path login == PR author; path build_id == record build_id; prev is this build's
    if not BUILD_ID_RE.match(rec["build_id"]): rej.append(f"build_id {rec['build_id']!r} is not 16 lowercase hex chars")
    pm = PATH_RE.match(repo_path or "")
    if not pm:
        rej.append(f"path {repo_path!r} is not submissions/<github-login>/<build_id>.json")
    else:
        if canon(pm.group(1)).lower() != canon(author).lower():
            rej.append(f"path login {pm.group(1)!r} is not the PR author {author!r}")
        if pm.group(2) != rec["build_id"]:
            rej.append(f"path build_id {pm.group(2)!r} is not the record's build_id {rec['build_id']!r}")
    if prev is not None and prev.get("final"):
        rej.append("this build was already marked final; start a new build for more")
    if prev is not None and prev.get("build_id") != rec["build_id"]:
        rej.append(f"previous record is from build {prev.get('build_id')!r}, not this build {rec['build_id']!r}")
    if prev is not None and proof_of(prev) != pk:
        rej.append(f"this build was a {PROOFS.get(proof_of(prev), {}).get('label', proof_of(prev))} build; a build "
                   "cannot switch proofs (each proof gets its own build_id)")
    # times
    try:
        started, recorded = parse_ts(rec["started"]), parse_ts(rec["recorded"])
    except ValueError as e:
        rej.append(f"time: {e}")
        return rej, flags, None
    if recorded < started: rej.append("recorded is before started")
    if recorded > now + CLOCK_SKEW: rej.append(f"recorded {rec['recorded']} is in the future")
    if rec["busy_seconds"] < 0 or rec["busy_seconds"] > (recorded - started).total_seconds() + 60:
        rej.append("busy_seconds is negative or longer than started..recorded")
    # bitmap
    n = P["n"]
    try:
        raw = decode_bitmap(rec["bitmap_b64"], n)
    except ValueError as e:
        rej.append(f"bitmap: {e}")
        return rej, flags, None
    pop = popcount(raw)
    if rec["modules_compiled"] != pop:
        rej.append(f"modules_compiled {rec['modules_compiled']} != popcount(bitmap) {pop}")
    if pop == 0: rej.append("bitmap is empty")
    # whole proof
    if rec["whole_proof"]:
        if pop != n: rej.append(f"whole_proof claimed but only {pop:,} of {n:,} modules compiled")
        ax, want_ax = rec["axioms"], P["axioms"]
        if ax is None: rej.append("whole_proof claimed but the axiom check did not run (axioms is null)")
        elif not all(isinstance(x, str) for x in ax) or len(ax) != len(want_ax) or set(ax) != set(want_ax):
            bad = sorted(set(map(str, ax)) - set(want_ax))
            rej.append(f"whole_proof axioms {ax} are not exactly {want_ax}" + (f" (extra: {bad})" if bad else ""))
    elif rec["axioms"] is not None and not all(isinstance(a, str) for a in rec["axioms"]):
        rej.append("axioms must be null or a list of names")
    # levels: export reproduced (2), independent checker accepted it (3); signing needs Level 2+
    if "export_sha256" in rec:
        if not rec["whole_proof"]: rej.append("export_sha256 is only meaningful with whole_proof")
        if not P["levels"]:                            # 300K: any hash is carried (gathered until builders agree)
            if not re.fullmatch(r"[0-9a-f]{64}", str(rec["export_sha256"])):
                rej.append("export_sha256 must be 64 lowercase hex characters")
        elif str(rec["export_sha256"]).lower() != REF_EXPORT_SHA256: rej.append("export does not reproduce the reference")
    if "export_bytes" in rec:
        if "export_sha256" not in rec: rej.append("export_bytes without export_sha256")
        if not P["levels"]:
            if isinstance(rec["export_bytes"], int) and rec["export_bytes"] < 0:
                rej.append("export_bytes must not be negative")
        elif rec["export_bytes"] != REF_EXPORT_BYTES:
            rej.append(f"export_bytes {rec['export_bytes']:,} is not the reference {REF_EXPORT_BYTES:,}")
    for c in rec.get("checkers") or []:
        if not (isinstance(c, dict) and set(c) == {"name", "version", "result", "seconds"} and isinstance(c["name"], str)
                and isinstance(c["version"], str) and c["result"] in ("accept", "reject")
                and isinstance(c["seconds"], (int, float)) and not isinstance(c["seconds"], bool)):
            rej.append("checkers entries must be {name, version, result: accept|reject, seconds}"); break
        if c["name"] not in KNOWN_CHECKERS:
            flags.append(f"checker {c['name']!r} is not one of {sorted(KNOWN_CHECKERS)}; it does not count for Level 3")
        if c["result"] == "reject":
            flags.append(f"CHECKER REJECTED THE EXPORT: {c['name']} {c['version']} (needs a human look)")
    if rec.get("checkers") and "export_sha256" not in rec: rej.append("checkers reported without an export_sha256")
    ep = rec.get("export_progress")
    if ep is not None:
        if not rec["whole_proof"]: rej.append("export_progress is only meaningful with whole_proof")
        if set(ep) != set(EXPORT_PROGRESS) or any(not isinstance(ep[k], t) or isinstance(ep[k], bool) != (t is bool)
                                                  for k, t in EXPORT_PROGRESS.items()):
            rej.append(f"export_progress must be {{{', '.join(EXPORT_PROGRESS)}}} with the right types")
        elif not (0 <= ep["bytes"] <= REF_EXPORT_BYTES * 2 and ep["seconds"] >= 0
                  and (ep["left_seconds"] is None or ep["left_seconds"] >= 0)
                  and (ep["peak_memory_gb"] is None or 0 <= ep["peak_memory_gb"] <= 1 << 16)):
            rej.append("export_progress numbers out of range")
    cr = rec.get("crashes")
    if cr is not None:
        def crash_ok(c):
            try:
                return (isinstance(c, dict) and set(c) == {"module", "code", "at"} and isinstance(c["module"], str)
                        and CRASH_MODULE_RE.fullmatch(c["module"]) is not None and type(c["code"]) is int
                        and -1000 < c["code"] < 1000 and parse_ts(c["at"]) is not None)
            except ValueError:
                return False
        if len(cr) > CRASHES_MAX or not all(crash_ok(c) for c in cr):
            rej.append(f"crashes must be at most {CRASHES_MAX} {{module, code, at}} entries")
    # one joint statement for every proof (2026-11-27): signed on any whole build with only the three standard
    # axioms; false = an explicit opt-out (sign --cancel), allowed on any record
    if rec.get("sign_statement") is True and not signs_300k(rec):
        rej.append("sign_statement needs the whole proof with only the three standard axioms")
    # growth + speed against this build's last accepted record
    prev_raw, since = None, started
    if prev is not None:
        try:
            prev_raw = decode_bitmap(prev["bitmap_b64"], n)
            since = parse_ts(prev["recorded"])
        except (KeyError, ValueError) as e:
            rej.append(f"previous accepted record unreadable: {e}")
    if prev_raw is not None:
        if recorded <= since and rec != prev:          # the same record pushed again (a re-submit) is fine, not news
            rej.append(f"recorded {rec['recorded']} is not after the last accepted record {prev['recorded']}")
        if not is_superset(raw, prev_raw):
            lost = popcount(bytes(a & ~b & 0xFF for a, b in zip(prev_raw, raw)))
            rej.append(f"bitmap shrank: {lost:,} modules from the last accepted record are missing")
    new = pop - (popcount(prev_raw) if prev_raw is not None else 0)
    hours = max((recorded - since).total_seconds(), SPEED_MIN_WINDOW) / 3600   # short gaps judged over >= 10 min
    rate = max(new, 0) / hours
    cores = rec.get("machine", {}).get("cores")
    cores = min(max(cores, 1), SPEED_CORES_CAP) if isinstance(cores, int) and not isinstance(cores, bool) else 1
    reject_at = max(SPEED_REJECT, SPEED_REJECT_PER_CORE * cores)
    flag_at = max(SPEED_FLAG, SPEED_FLAG_PER_CORE * cores)
    if rate > reject_at:
        rej.append(f"speed implausible: {new:,} new modules in {hours:.2f} h = {rate:,.0f}/h (limit {reject_at:,}/h for {cores} cores)")
    elif rate > flag_at:
        flags.append(f"fast: {new:,} new modules in {hours:.2f} h = {rate:,.0f}/h (flag above {flag_at:,}/h for {cores} cores)")
    # digest (off until M0; there is no reference build for 300K at all)
    if check_digest and not rej and not P["digest_reference"]:
        flags.append(f"olean_digest not checked: no {P['label']} reference build")
    elif check_digest and not rej:
        try:
            want = reference_digest(raw)
            if rec["olean_digest"].lower() != want:
                rej.append(f"olean_digest {rec['olean_digest'][:16]}... != reference {want[:16]}... for this bitmap")
        except LookupError as e:
            flags.append(f"PENDING digest: {e}")
    return rej, flags, raw


# ---- aggregate ----------------------------------------------------------------------------------------------
def load_accepted(dirs, check_digest=False, now=None, log=print):
    """(login, build_id) -> (repo_path, record, bitmap): the newest valid version of each build across dirs."""
    out = {}
    dirs = [Path(d) for d in dirs if Path(d).exists()]
    for d in dirs:
        for f in sorted(d.glob("*/*.json")):
            login, rp = f.parent.name, f"submissions/{f.parent.name}/{f.name}"
            if canon(login).lower() in REMOVED or login.lower() in REMOVED:
                continue
            try:
                r = load_record(f)
                # logins=None: names were judged when the version was accepted and are not re-judged here
                rej, _, raw = check_record(r, login, rp, None, check_digest=check_digest, now=now)
            except Exception as e:
                rej, raw = [f"unreadable: {e}"], None
            if rej:
                log(f"skip {f}: {'; '.join(rej)}", file=sys.stderr)
                continue
            key = (canon(login), r["build_id"])
            if key not in out or r["recorded"] > out[key][1]["recorded"]:
                out[key] = (rp, r, raw)
    return out


def mach(r):
    return r["machine"].get("cpu") or r["machine"].get("os", "")


def export_view(r):
    """The page's view of a record's export: progress while it runs; when done, whether it matched (the bot decides
    that from export_sha256, never from the volunteer's say-so)."""
    ep = r.get("export_progress")
    if not ep:
        return None
    v = {"bytes": ep["bytes"], "total": REF_EXPORT_BYTES, "seconds": int(ep["seconds"]), "done": ep["done"],
         "left_seconds": None if ep["done"] or ep["left_seconds"] is None else int(ep["left_seconds"]),
         "peak_memory_gb": None if ep["peak_memory_gb"] is None else round(ep["peak_memory_gb"], 1)}
    if ep["done"]:
        v["matches"] = record_level(r) >= 2
    return v


def ledger_keys(proof: str):
    """The finish-time ledger's keys for a proof: (finish time, build hours). 17M keeps its old names."""
    return ("whole", "hours") if proof == DEFAULT_PROOF else (f"whole_{proof}", f"hours_{proof}")


def tier_of(finished: list) -> str:
    """Leaderboard tier from the proofs a person finished (PROOFS order): "17m+300k", "17m", "300k", or "partial"."""
    return "+".join(finished) if finished else "partial"


SIG300 = "#300k"                                       # signed_map key suffix: the 300K statement's signing time


def build_data(dirs, now=None, signed_map=None, firsts=None, published=None) -> dict:
    """signed_map: login -> time their signing version was accepted (the bot records it); people missing from it get
    the signing record's `recorded` time (aggregate without the bot's ledger).
    firsts: login -> {"whole": first whole-proof `recorded`, "validated": first Level 2+ `recorded`, "hours": build
    hours then; and for other proofs "whole_300k", "hours_300k"} (the bot's ledger, updated here). A build is ONE file
    that each `submit` overwrites, so the records alone only show the newest version: without the ledger,
    re-submitting a finished build moved its finish date (issue #12, 2026-11-25). Each entry only ever moves earlier.
    published: the data.json already on main. Its finish, Level 2 and signing times are merged in (earlier wins), so
    losing the bot's state (and its backups) cannot move them either.
    Leaderboard (CONTRACT "Several proofs"): one row per person. The original fields (modules, whole_proof,
    build_hours, finished, first_whole_proof_rank, level, ...) stay about 17M; `proofs` has one entry per proof the
    person built. Rows are ordered by tier: every proof finished, then 17M only, then 300K only, then partial builds;
    inside a tier by who finished the tier's first proof first; partial builds by modules, then since."""
    signed_map = {} if signed_map is None else signed_map
    firsts = {} if firsts is None else firsts
    for old in [k for k in list(firsts) + list(signed_map) if canon(k) != k]:   # renamed: fold into the new login
        new = canon(old)
        if old in firsts:
            e, o = firsts.setdefault(new, {}), firsts.pop(old)
            for k, t in o.items():
                if k.startswith("hours"): e.setdefault(k, t)
                else: e[k] = min(e.get(k) or t, t)
        if old in signed_map:
            t = signed_map.pop(old); signed_map[new] = min(signed_map.get(new) or t, t)
    signatures = []
    exports_300k = {}                                  # sha256 -> names: the 300K export hashes builders got
    mods = modules()
    people = {}
    for (login, build_id), v in load_accepted(dirs, now=now).items():
        people.setdefault(login, {})[build_id] = v
    ident = {}                                         # login -> (name, who): the choice in their newest record
    for login, builds in people.items():
        newest = max((v[1] for v in builds.values()), key=lambda r: r["recorded"])
        if newest.get("display_name"):
            ident[login] = (clean_display_name(newest["display_name"]), None)
        else:
            ident[login] = (login, login)
    if published:
        by_key = {(shown or name): login for login, (name, shown) in ident.items()}
        for r in published.get("leaderboard") or []:
            login = by_key.get(r.get("who") or r.get("name"))
            if not login:
                continue
            got = [("whole", r.get("finished")), ("validated", r.get("validated_at"))]
            got += [(ledger_keys(pk)[0], (pv or {}).get("finished")) for pk, pv in (r.get("proofs") or {}).items()
                    if pk in PROOFS and isinstance(pv, dict)]
            for k, t in got:
                if t:
                    e = firsts.setdefault(login, {})
                    e[k] = min(e.get(k) or t, t)
        for g in published.get("signatures") or []:
            login = by_key.get(g.get("who") or g.get("name"))
            if login and g.get("signed") and g.get("via", "signed") == "signed":   # self-signed times only
                signed_map[login] = min(signed_map.get(login) or g["signed"], g["signed"])
    counts = bytearray(N)                              # terrain: the 17M proof's modules
    rows, latest, running, crashes = [], None, [], {}
    for who, builds in sorted(people.items()):
        name, shown = ident[who]
        mine = firsts.setdefault(who, {})
        by_proof = {}
        for build_id, v in builds.items():
            by_proof.setdefault(proof_of(v[1]), {})[build_id] = v
        proofs = {}
        for pk, pb in by_proof.items():                # per proof: union of that proof's builds
            P, union = PROOFS[pk], 0
            for _, _, raw in pb.values():
                union |= int.from_bytes(raw, "little")
            precs = [v[1] for v in pb.values()]
            pw = sorted((r for r in precs if r["whole_proof"]), key=lambda r: r["recorded"])
            kw, kh = ledger_keys(pk)
            if pw:
                mine[kw] = min(mine.get(kw) or pw[0]["recorded"], pw[0]["recorded"])
                # as it was when they finished; kept exact (owner, 2026-11-27: track it accurately, round only on the page)
                mine.setdefault(kh, round(pw[0]["busy_seconds"] / 3600, 6))
            proofs[pk] = {"modules": union.bit_count(), "n": P["n"], "whole": bool(pw),
                          "finished": mine[kw] if pw else None, "build_hours": mine[kh] if pw else None,
                          # exact, for picking the fastest build (build_hours is rounded to 0.1 h: 300K builds tied)
                          "build_seconds": pw[0]["busy_seconds"] if pw else None,
                          "computers": len(pb), "rank": None,
                          "machine": mach(max(precs, key=lambda r: (r["modules_compiled"], r["recorded"])))}
            if pk == DEFAULT_PROOF:
                raw17 = union.to_bytes((N + 7) // 8, "little")
                for i in indices(raw17):               # one person counts once per module, however many builds
                    if counts[i] < BUILDERS_CAP:
                        counts[i] += 1
        recs = [v[1] for v in by_proof.get(DEFAULT_PROOF, {}).values()]     # the 17M fields below
        allrecs = [v[1] for v in builds.values()]
        p17 = proofs.get(DEFAULT_PROOF) or {}
        whole = bool(p17.get("whole"))
        lv2 = [r["recorded"] for r in recs if record_level(r) >= 2]
        if lv2:
            mine["validated"] = min(mine.get("validated") or min(lv2), min(lv2))
        if not mine:
            del firsts[who]
        level = max((record_level(r) for r in recs), default=1)
        # The one joint statement (2026-11-27): everyone with a whole build of either proof (only the three standard
        # axioms), ordered by when they first finished, with a badge per thing they did. Self-signed (sign_statement
        # true on any record) or, for everyone else, listed from their build record (owner, 2026-11-27). An opt-out
        # always wins: false in their newest record that says either way, or their login in bot/optout.json.
        for legacy in (who + SIG300,):                 # 300K signing times kept under their own key before
            if legacy in signed_map:
                t = signed_map.pop(legacy); signed_map[who] = min(signed_map.get(who) or t, t)
        said = [r for r in allrecs if "sign_statement" in r]
        newest_say = max(said, key=lambda r: r["recorded"]) if said else None
        opted_out = canon(who).lower() in OPTOUT or (newest_say is not None and newest_say["sign_statement"] is False)
        own = sorted((r for r in allrecs if r.get("sign_statement") is True and signs_300k(r)), key=lambda r: r["recorded"])
        P3 = PROOFS["300k"]                            # their newest 300K export, if any
        x300 = max((v[1] for v in by_proof.get("300k", {}).values() if v[1].get("export_sha256")),
                   key=lambda r: r["recorded"], default=None)
        x300_match = bool(x300 and P3["export_sha256"] and x300["export_sha256"] == P3["export_sha256"]
                          and x300.get("export_bytes") == P3["export_bytes"])
        if x300:
            exports_300k.setdefault(x300["export_sha256"], []).append(name)
        built = {pk: sorted((r for r in (v[1] for v in by_proof.get(pk, {}).values()) if signs_300k(r)),
                            key=lambda r: r["recorded"]) for pk in PROOFS}
        if not opted_out and (own or any(built.values())):
            done = {pk: (proofs.get(pk) or {}).get("finished") for pk in PROOFS if built[pk]}
            first = min([t for t in done.values() if t] + ([own[0]["recorded"]] if own else []))
            checkers = sorted({c["name"] for r in recs for c in r.get("checkers") or []
                               if c.get("result") == "accept" and c.get("name") in KNOWN_CHECKERS})
            badges = []
            if built.get(DEFAULT_PROOF):
                badges.append({"kind": "17m", "label": "17M BUILT"})
            if built.get("300k"):
                badges.append({"kind": "300k", "label": "300K BUILT"})
            if level >= 2:
                badges.append({"kind": "export", "label": "EXPORT REPRODUCED"})
            badges += [{"kind": "recheck", "label": f"RE-CHECKED: {c}"} for c in checkers]
            if x300 and x300_match:
                badges.append({"kind": "export300k", "label": "300K EXPORT REPRODUCED"})
            e = {"who": shown, "name": name, "first_finished": first, "badges": badges, "level": level,
                 "checkers": checkers, "machine": mach((own or built.get(DEFAULT_PROOF) or built.get("300k"))[0])}
            if own:
                signed_map.setdefault(who, own[0]["recorded"])
                e.update(signed=signed_map[who], via="signed")
            else:
                e.update(signed=first, via="record")   # added from their build record, not signed by them
            signatures.append(e)
        finished = [pk for pk in PROOFS if (proofs.get(pk) or {}).get("whole")]
        rows.append({"name": name, "who": shown, "_login": who, "level": level, "modules": p17.get("modules", 0),
                     "whole_proof": whole,
                     "build_hours": p17["build_hours"] if whole else None,
                     "finished": p17["finished"] if whole else None,
                     "validated_at": mine["validated"] if lv2 else None,
                     # machine: of their largest 17M build (as before); 300K-only people: of their 300K build
                     "machine": (p17 or next(iter(proofs[pk] for pk in PROOFS if pk in proofs)))["machine"],
                     "computers": len(builds),
                     "since": min(r["started"] for r in allrecs),
                     "proofs": {pk: proofs[pk] for pk in PROOFS if pk in proofs},
                     "tier": tier_of(finished)})
        for r in allrecs:                              # which modules crash Lean, and on whose computers
            for c in r.get("crashes") or []:
                k = crashes.setdefault(c["module"], {"module": c["module"], "codes": set(), "names": set(), "times": 0, "last": ""})
                k["codes"].add(c["code"]); k["names"].add(name); k["times"] += 1; k["last"] = max(k["last"], c["at"])
        exp = max((r for r in recs if r.get("export_progress")), key=lambda r: r["recorded"], default=None)
        if exp:
            rows[-1]["export"] = export_view(exp)
        for build_id, (_, r, _) in builds.items():
            pk = proof_of(r)
            exporting = bool(r.get("export_progress")) and not r["export_progress"]["done"]
            if (not r["whole_proof"] or exporting) and not r.get("final"):   # running: building, or exporting
                e = {"name": name, "who": shown, "build_id": build_id, "machine": mach(r),
                     "modules": r["modules_compiled"], "recorded": r["recorded"]}
                if pk != DEFAULT_PROOF:
                    e["proof"] = pk                    # absent = 17M, as in records
                if exporting:
                    e["export"] = export_view(r)
                if shown is None:
                    del e["build_id"]                  # display-name people: build_id would link to the login
                running.append(e)
            if latest is None or r["recorded"] > latest["recorded"]:
                latest = {"name": name, "who": shown, "modules": r["modules_compiled"], "recorded": r["recorded"], "machine": mach(r)}
                if pk != DEFAULT_PROOF:
                    latest["proof"] = pk
    # who finished each proof first: 17M keeps its old field, every proof gets proofs[pk]["rank"]
    for pk in PROOFS:
        done = sorted((x for x in rows if (x["proofs"].get(pk) or {}).get("whole")),
                      key=lambda x: (x["proofs"][pk]["finished"], x["_login"]))
        for rank, row in enumerate(done, 1):
            row["proofs"][pk]["rank"] = rank
    for row in rows:
        row["first_whole_proof_rank"] = (row["proofs"].get(DEFAULT_PROOF) or {}).get("rank")
    order = list(PROOFS)

    def place(x):
        """Tier first (more proofs finished; then the heavier proof: PROOFS order), then inside the tier who
        finished its first proof first; partial builds by modules (17M first), then since."""
        fin = [order.index(pk) for pk in order if (x["proofs"].get(pk) or {}).get("whole")]
        if fin:
            return (0, -len(fin), fin, x["proofs"][order[fin[0]]]["rank"], (), x["since"], x["_login"])
        return (1, 0, [], 0, tuple(-(x["proofs"].get(pk) or {}).get("modules", 0) for pk in order), x["since"], x["_login"])
    rows.sort(key=place)
    for row in rows:
        del row["_login"]
    libs, prev = [], None
    for i, m in enumerate(mods):
        top = m.split(".")[0]
        if top != prev:
            libs.append([top, i]); prev = top
    return {
        "generated": (now or datetime.now(timezone.utc)).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "n": N,
        "libraries": libs,
        "builders_b64": encode_bitmap(bytes(counts)),
        "summary": {"people": len(rows), "whole_proofs": sum(r["whole_proof"] for r in rows),
                    "modules_built_once": sum(1 for c in counts if c >= 1),
                    "modules_built_3x": sum(1 for c in counts if c >= 3)},
        # the proofs this board counts (CONTRACT "Several proofs"); `n`, `libraries` and the terrain are 17M's
        "proofs": {pk: {"label": P["label"], "title": P["title"], "n": P["n"], "toolchain": P["toolchain"],
                        "source": {P["source_field"]: P["source"]},
                        "whole_proofs": sum(1 for r in rows if (r["proofs"].get(pk) or {}).get("whole"))}
                   for pk, P in PROOFS.items()},
        "leaderboard": rows,
        "latest": latest,
        "running": sorted(running, key=lambda x: (-x["modules"] / PROOFS[x.get("proof", DEFAULT_PROOF)]["n"],
                                                  x["recorded"], x["name"], x.get("build_id", ""))),
        # first to finish comes first, like the leaderboard (one joint statement, 2026-11-27)
        "signatures": sorted(signatures, key=lambda x: (x["first_finished"], x["name"])),
        "validated": VALIDATED,
        # the 300K proof's optional export: no reference yet; everyone's hash, to see when three builders agree
        "export_300k": {"reference": PROOFS["300k"]["export_sha256"], "agree_needed": EXPORT_300K_AGREE,
                        "builders": sum(len(v) for v in exports_300k.values()),
                        "hashes": {h: sorted(v) for h, v in sorted(exports_300k.items(), key=lambda kv: (-len(kv[1]), kv[0]))}},
        # Lean crashes reported by builds (the tool restarts a crashed build): which module, how often, for whom
        "crashes": sorted(({**c, "codes": sorted(c["codes"]), "names": sorted(c["names"])} for c in crashes.values()),
                          key=lambda c: (-len(c["names"]), -c["times"], c["module"])),
    }


def write_json_backed_up(path: Path, obj, backup=True):
    if backup and path.exists():
        shutil.copy2(path, path.with_name(path.name + ".bak"))
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(obj, indent=1) + "\n")
    os.replace(tmp, path)


def content_hash(data) -> str:
    return hashlib.sha256(json.dumps({k: v for k, v in data.items() if k not in ("generated", "recent")},
                                     sort_keys=True).encode()).hexdigest()


SITE_URL = "https://riemann-at-home.github.io/riemann-at-home/"
HN_URL = "https://news.ycombinator.com/item?id=50594006"


def _page_parts(index_html: str):
    """The join prompt and the joint statement, taken from the homepage itself so the wording never drifts."""
    import html as _html
    m = re.search(r"const prompt = `(.*?)`;", index_html, re.S)
    prompt = m[1].strip() if m else ""
    return prompt, _statement_md(index_html, '<div class="stmt">', '<div class="sofar"')


def _statement_md(index_html: str, start: str, end: str) -> str:
    """The joint statement panel of the homepage as markdown (one letter for every proof since 2026-11-27)."""
    import html as _html
    stmt = ""
    i = index_html.find(start)
    j = index_html.find(end, i)
    if i >= 0 and j > i:
        t = index_html[i:j]
        t = re.sub(r"<code>(.*?)</code>", r"`\1`", t)
        t = re.sub(r'<a [^>]*href="([^"]+)"[^>]*>(.*?)</a>', r"[\2](\1)", t)
        t = re.sub(r"<h4>(.*?)</h4>", r"", t)
        t = re.sub(r'<span class="lvl[^"]*">(.*?)</span>\s*', r"**\1** ", t)          # the badges, in words
        t = re.sub(r'<ul class="badgekey">(.*?)</ul>',
                   lambda mm: re.sub(r"<li>(.*?)</li>", r"\n- \1", mm[1], flags=re.S), t, flags=re.S)
        n = iter(range(1, 50))
        t = re.sub(r"<li>(.*?)</li>", lambda mm: f"\n{next(n)}. {mm[1]}", t, flags=re.S)
        t = re.sub(r"<p>(.*?)</p>", r"\n\n\1\n\n", t, flags=re.S)
        t = re.sub(r"<[^>]+>", "", t)
        stmt = re.sub(r"\n[ \t]*\n[\s]*", "\n\n", _html.unescape(t)).strip()
        stmt = re.sub(r"\n\n(\d+\. )", r"\n\1", stmt)
    return stmt


def _confused_md(index_html: str) -> str:
    """The homepage's plain-language explainer (<section id="confused">) as markdown, or "" if the page has none."""
    import html as _html
    m = re.search(r'<section id="confused">(.*?)</section>', index_html, re.S)
    if not m:
        return ""
    t = re.sub(r"<!--.*?-->", "", m[1], flags=re.S)
    t = re.sub(r"<h2>(.*?)</h2>", r"\n\n## \1\n\n", t, flags=re.S)
    t = re.sub(r"<h3>(.*?)</h3>", r"\n\n### \1\n\n", t, flags=re.S)
    t = re.sub(r'<a [^>]*href="([^"]+)"[^>]*>(.*?)</a>', r"[\2](\1)", t, flags=re.S)
    t = re.sub(r"<b>(.*?)</b>", r"**\1**", t, flags=re.S)
    t = re.sub(r"<p>(.*?)</p>", r"\n\n\1\n\n", t, flags=re.S)
    t = re.sub(r"<[^>]+>", "", t)
    t = "\n".join(line.strip() for line in _html.unescape(t).splitlines())
    return re.sub(r"\n{3,}", "\n\n", t).strip()


def homepage_markdown(data: dict, index_html: str) -> str:
    """docs/index.md: the homepage as plain markdown for AI assistants and other readers (rewritten on each publish)."""
    prompt, stmt = _page_parts(index_html)
    n, sm = data["n"], data["summary"]
    f = lambda x: f"{x:,}"
    pct = lambda m: f"{m / n * 100:.1f}%"
    who = lambda r: r["name"] + (f" (github.com/{r['who']})" if r.get("who") and r["who"] != r["name"] else
                                 (f" (github.com/{r['who']})" if r.get("who") else ""))
    out = [
        "# Riemann@home",
        "",
        "Every independent build of the AI proof of the Riemann Hypothesis.",
        "",
        f"Levent Alpöge's Lean proof of the Riemann Hypothesis (17M) has {f(n)} modules. A second, much shorter "
        "proof (300K: the readable edition of grh-lean, about 300,000 lines) is built the same way. Volunteers build "
        "them on their own computers with the official tools, and each computer reports its progress through a "
        "public GitHub pull request. A bot checks every report and publishes this page.",
        "",
        f"- Live page: {SITE_URL}",
        "- Code and instructions: https://github.com/riemann-at-home/riemann-at-home",
        f"- Discuss on Hacker News: {HN_URL}",
        f"- Raw data: {SITE_URL}data.json (format: CONTRACT.md in the repository)",
        f"- Updated: {data.get('generated', 'unknown')}",
        "",
        "## Totals",
        "",
        f"- Builders: {f(sm['people'])}",
        f"- Modules built at least once: {f(sm['modules_built_once'])} of {f(n)} ({pct(sm['modules_built_once'])})",
        f"- Modules built 3 or more times: {f(sm['modules_built_3x'])}",
        f"- Whole proofs finished (17M): {f(sm['whole_proofs'])}",
    ]
    for pk, pv in (data.get("proofs") or {}).items():
        if pk != DEFAULT_PROOF:
            out.append(f"- Whole proofs finished ({pv['label']}): {f(pv.get('whole_proofs', 0))}")
    out.append("")
    # One leaderboard, as on the page: one row per person, in tiers (both proofs, 17M only, 300K only); inside the
    # 17M tiers validators first (as on the page since 2026-11-23), then everyone building.
    info = data.get("proofs") or {DEFAULT_PROOF: {"label": "17M", "n": n}}
    board = data.get("leaderboard") or []
    hrs = lambda x: f"{x:.1f} h" if x < 100 else f"{x:.0f} h"
    def built(r):
        out = []
        for pk, pv in (r.get("proofs") or {}).items():
            if pv.get("whole"):
                lab = info.get(pk, {}).get("label", pk)
                out.append(f"{lab}: all {f(pv['modules'])} modules" + (f" in {hrs(pv['build_hours'])}" if pv.get("build_hours") else ""))
        if not out and r.get("whole_proof"):           # a data.json from before `proofs`
            out.append(f"all {f(r['modules'])} modules" + (f", built in {r['build_hours']:.1f} h" if r.get("build_hours") else ""))
        return "; ".join(out) + (f", {r['machine']}" if r.get("machine") else "")
    signed = {g.get("who") or g.get("name") for g in data.get("signatures") or []}
    def extra(r):
        out = ""
        if (r.get("level") or 0) >= 2:
            out += ", export reproduced" + (", signed the joint statement" if (r.get("who") or r["name"]) in signed else "")
        elif (r.get("export") or {}).get("done") is False:
            out += ", exporting now"
        return out
    tiers = {}
    for r in board:
        t = r.get("tier") or ("17m" if r.get("whole_proof") else "partial")
        tiers.setdefault(t, []).append(r)
    def ordered(rs):                                   # 17M tiers: validators first, in the order they got there
        return (sorted((r for r in rs if (r.get("level") or 0) >= 2), key=lambda r: str(r.get("validated_at") or r.get("finished")))
                + [r for r in rs if (r.get("level") or 0) < 2])
    out += ["## Leaderboard", ""]
    rank, any_row = 0, False
    for t, title in [("+".join(info), "Both proofs built")] + [(pk, f"{v['label']} proof built") for pk, v in info.items()]:
        rs = tiers.get(t) or []
        if not rs:
            continue
        any_row = True
        out += [f"### {title}", ""]
        for r in (ordered(rs) if DEFAULT_PROOF in t.split("+") else rs):
            rank += 1
            out.append(f"{rank}. {who(r)}: {built(r)}{extra(r)}")
        out.append("")
    if not any_row:
        out += ["No one has built a whole proof yet.", ""]
    out += ["### Building now", ""]
    done_who = {(r.get("who") or r["name"], pk) for r in board for pk, pv in (r.get("proofs") or {}).items() if pv.get("whole")}
    done_who |= {(r.get("who") or r["name"], DEFAULT_PROOF) for r in board if r.get("whole_proof")}
    tot = lambda r: (info.get(r.get("proof", DEFAULT_PROOF)) or {}).get("n", n)
    run = sorted((r for r in data.get("running") or [] if not (r["modules"] >= tot(r) and (r.get("who") or r["name"], r.get("proof", DEFAULT_PROOF)) in done_who)),
                 key=lambda r: -r["modules"] / tot(r))
    out += [f"- {who(r)}: {f(r['modules'])} of {f(tot(r))} {(info.get(r.get('proof', DEFAULT_PROOF)) or {}).get('label', '')} modules "
            f"({r['modules'] / tot(r) * 100:.1f}%)" + (f", {r['machine']}" if r.get("machine") else "")
            for r in run] or ["No builds in progress."]
    val = data.get("validated") or []
    if val:
        out += ["", "## Also checked independently by", ""]
        out += [f"- {v['who']}: {v['what']} ({v['url']})" for v in val]
        out += ["", "As each person reported it publicly."]
    out += ["", "## Join in", "",
            "Paste this into an AI assistant that can run commands (Claude, ChatGPT, ...):", "", "```", prompt, "```", "",
            "What becomes public: your GitHub username (on the commits and the pull request), your computer's OS, chip "
            "and number of cores, and which modules you've built. Nothing is posted until you agree."]
    if stmt:   # one joint statement for every proof (2026-11-27): everyone, first to finish first, with badges
        sigs = data.get("signatures") or []
        out += ["", "## Joint statement", "", stmt, "", f"Signatures so far: {len(sigs)}, in the order they first finished."]
        for g in sigs:
            when = (f"first finished {str(g.get('first_finished') or g.get('signed', ''))[:10]}, added from their build record"
                    if g.get("via") == "record" else f"signed {str(g.get('signed', ''))[:10]}")
            out.append(f"- {g.get('name') or g.get('who')} ({when}): "
                       + (", ".join(b["label"] for b in g.get("badges") or []) or "17M BUILT"))
        out += ["", "Signing is on by default when a build qualifies; withdraw any time with `riemann-at-home sign "
                "--cancel`, or ask in an issue to be removed."]
    confused = _confused_md(index_html)
    if confused:
        out += ["", confused]
    return "\n".join(out).rstrip() + "\n"


RECENT_MAX = 20000   # most modules listed in data.json "recent" (the page replays them; more would just be noise)


def recent_since(prev: dict, data: dict):
    """Modules that gained a builder since the previously published data.json, for the page to replay one by one:
    {"since": prev generated, "gaps": [first index, then differences]} (sorted, delta-coded), or None."""
    try:
        old = gzip.decompress(base64.b64decode(prev["builders_b64"]))
        new = gzip.decompress(base64.b64decode(data["builders_b64"]))
    except (KeyError, ValueError, OSError, TypeError):
        return None
    if len(old) != len(new):
        return None
    idx = [i for i in range(len(new)) if new[i] > old[i]]
    if len(idx) > RECENT_MAX:                      # keep an even sample across the proof
        step = len(idx) / RECENT_MAX
        idx = [idx[int(k * step)] for k in range(RECENT_MAX)]
    gaps, last = [], 0
    for i in idx:
        gaps.append(i - last); last = i
    return {"since": prev.get("generated"), "gaps": gaps}


